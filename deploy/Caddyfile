# Replace with the host's name. Caddy gets a certificate for it on its own.
avicoin.example.com {
	# TLS and nothing else. There is no rate limit here: Caddy has no built-in
	# one, and the bounds that matter are the node's own — four workers, a
	# sixteen-deep queue, and a header and body cap on every request.
	reverse_proxy node:8080

	log {
		output stdout
		format console
	}
}
