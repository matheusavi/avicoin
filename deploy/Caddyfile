# Replace with the host's name. Caddy gets a certificate for it on its own.
avicoin.example.com {
	# Every request is a read except two, and both of those are refused from
	# another origin by the node itself. This is a rate limit, not an
	# authorisation layer: the API has nothing to authorise, because it can
	# neither sign nor spend.
	reverse_proxy node:8080

	log {
		output stdout
		format console
	}
}
