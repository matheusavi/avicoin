{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": ["claudecode"],
  "features": ["skills"],
  // "*" takes the whole engineering directory: the skills cross-reference each
  // other heavily, and a pinned per-skill list silently rots whenever one is
  // renamed upstream (to-issues -> to-tickets, to-prd -> to-spec bit us once).
  //
  // NOTE: rulesync keys its lockfile by repo slug alone, not repo+path, so a
  // second source entry for skills/productivity would overwrite this one. The
  // five productivity skills are therefore vendored under .claude/skills/ and
  // committed (see .gitignore) — grill-with-docs delegates to /grilling, which
  // lives there. Re-vendor by hand from mattpocock/skills:skills/productivity.
  "sources": [
    {
      "source": "https://github.com/mattpocock/skills",
      "transport": "git",
      "ref": "main",
      "path": "skills/engineering",
      "skills": ["*"]
    }
  ]
}
